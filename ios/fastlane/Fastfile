default_platform(:ios)

BUNDLE_ID = "com.autobus.app"
APP_NAME = "Nexus Asset App"
APP_SKU = "useautobus.01"
TEAM_ID = "LTYQMJBM79"

platform :ios do
  desc "Ensure Developer Portal Bundle ID (+ App Store Connect app if possible)"
  private_lane :ensure_app_identifiers do
    existing = Spaceship::ConnectAPI::BundleId.find(BUNDLE_ID)
    if existing
      UI.success("Bundle ID #{BUNDLE_ID} already exists")
    else
      UI.message("Creating Bundle ID #{BUNDLE_ID}…")
      platform =
        if defined?(Spaceship::ConnectAPI::Portal::BundleIdPlatform::IOS)
          Spaceship::ConnectAPI::Portal::BundleIdPlatform::IOS
        elsif defined?(Spaceship::ConnectAPI::BundleIdPlatform::IOS)
          Spaceship::ConnectAPI::BundleIdPlatform::IOS
        else
          "IOS"
        end

      Spaceship::ConnectAPI::BundleId.create(
        name: APP_NAME,
        identifier: BUNDLE_ID,
        platform: platform
      )
      UI.success("Created Bundle ID #{BUNDLE_ID}")
    end

    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    if app
      UI.success("App Store Connect app already exists for #{BUNDLE_ID}")
    else
      UI.message("Creating App Store Connect app '#{APP_NAME}'…")
      begin
        Spaceship::ConnectAPI::App.create(
          name: APP_NAME,
          version_string: "1.0.0",
          sku: APP_SKU,
          primary_locale: "en-US",
          bundle_id: BUNDLE_ID,
          platforms: ["IOS"]
        )
        UI.success("Created App Store Connect app '#{APP_NAME}'")
      rescue => e
        UI.important("ASC app create failed (create it manually in App Store Connect if upload fails): #{e.message}")
      end
    end
  end

  desc "Build signed IPA and upload to TestFlight"
  lane :release do
    setup_ci if ENV["CI"]
    # setup_ci forces Match readonly; first-time cert creation needs write access.
    ENV["MATCH_READONLY"] = "false"

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      duration: 1200,
      in_house: false
    )

    ensure_app_identifiers

    match(
      type: "appstore",
      api_key: api_key,
      readonly: false,
      git_branch: "main"
    )

    build_number = ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    increment_build_number(
      build_number: build_number,
      xcodeproj: "Runner.xcodeproj"
    )

    # Fastlane cwd is ios/; repo root is one level up.
    Dir.chdir("..") do
      sh("flutter", "pub", "get")
      sh("flutter", "build", "ios", "--release", "--no-codesign", "--build-number=#{build_number}")
    end

    profile_name =
      ENV["sigh_com.autobus.app_appstore_profile-name"] ||
      ENV["sigh_com_autobus_app_appstore_profile-name"]

    UI.user_error!("Could not resolve App Store provisioning profile name from Match") if profile_name.to_s.empty?

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: TEAM_ID,
      code_sign_identity: "iPhone Distribution",
      profile_name: profile_name,
      bundle_identifier: BUNDLE_ID
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        teamID: TEAM_ID,
        signingStyle: "manual",
        provisioningProfiles: {
          BUNDLE_ID => profile_name
        }
      },
      output_directory: "./build",
      output_name: "Autobus"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: ENV["RELEASE_NOTES"] || "Automated build from GitHub Actions"
    )
  end
end
